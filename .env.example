# (Disyorkan untuk elak HTTP 429 di Render) API Key percuma dari https://aistudio.google.com/apikey
# Bot akan auto-discover & auto-tukar model Gemini bila kena 429!
GEMINI_API_KEY=

# (Pilihan) Boleh letak banyak key dipisah dengan koma untuk kuota percuma berganda: key1,key2,key3
GEMINI_API_KEYS=

# (Pilihan) Senarai model tersuai; biarkan kosong untuk auto-discover semua model Gemini
GEMINI_MODELS=

# Port untuk halaman status & QR Code (Render tetapkan ini secara automatik)
PORT=3000

# Folder simpanan sesi WhatsApp (lalai: ./auth_info)
AUTH_DIR=./auth_info

# Suara TTS Arab lalai (lihat senarai suara dalam /suara)
DEFAULT_VOICE=ar-SA-HamedNeural

# Kelajuan suara lalai (-20%, +0%, +15%)
DEFAULT_RATE=+0%

# Kod bahasa/loghat Speech-to-Text Arab (ar-SA, ar-EG, ar-AE, ar-JO, ar-MA)
DEFAULT_STT_LANG=ar-SA

# Benarkan bot membalas mesej dalam "Message Yourself" / Nota Sendiri apabila dipanggil (true/false)
ALLOW_SELF_CHAT=true

# Benarkan bot membalas semua mesej/audio secara automatik di semua chat (disyorkan: false — panggil guna arahan /arab, /melayu, /menu)
AUTO_REPLY=false

# (Pilihan/Keserasian) Benarkan auto-balas khusus untuk grup secara lalai (disyorkan: false)
GROUP_AUTO_REPLY=false

# Tempoh maksima audio (saat) yang dibenarkan untuk transkripsi
MAX_AUDIO_SECONDS=300

# Had maksima pengguna WhatsApp yang boleh sambung serentak (lalai: 10)
MAX_SESSIONS=10

# Tempoh sesi setiap pengguna dalam minit sebelum auto-logout (lalai: 60 minit = 1 jam)
SESSION_DURATION_MINUTES=60

# Tempoh sah QR Code belum diimbas dalam saat sebelum slot dilepaskan (lalai: 120 saat)
PENDING_QR_TIMEOUT_SECONDS=120
